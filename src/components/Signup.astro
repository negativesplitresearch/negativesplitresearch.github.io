---
/**
 * Newsletter signup, built around Beehiiv's official embed.
 *
 * Why not our own <form>? On Beehiiv's free plan the only public submit
 * endpoints (subscribe-forms.beehiiv.com/api/submit and <pub>.beehiiv.com/create)
 * need a session CSRF token and sit behind Cloudflare + PerimeterX bot checks,
 * so a cross-site POST from this static site is rejected (403 + "Press & Hold").
 * The embed's look (background, input, button, font) is set in Beehiiv's form
 * editor; see README "Newsletter signup".
 *
 *   variant="band"  slim full-bleed strip (homepage, near the top)
 *   variant="block" full card (end of every issue, About)
 */
import { BEEHIIV_EMBED } from '../config';
interface Props {
  variant?: 'band' | 'block';
  heading?: string;
  blurb?: string;
  id?: string;
}
const {
  variant = 'block',
  heading = 'Get the next issue',
  blurb = 'One company, one deal, one set of numbers that matter. Free, in your inbox.',
  id,
} = Astro.props;
---
{variant === 'band' ? (
  <section id={id} class="signup-band scroll-mt-6 border-y border-[var(--color-rule)]" aria-label="Newsletter signup">
    <div class="wrap grid items-center gap-5 py-7 md:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] md:gap-10 md:py-8">
      <div>
        <p class="kicker">Free newsletter</p>
        <h2 class="mt-1.5 font-serif text-2xl leading-tight font-semibold tracking-tight sm:text-[1.7rem]">{heading}</h2>
        <p class="mt-1.5 text-base text-[var(--color-muted)]">{blurb}</p>
      </div>
      <div class="beehiiv-embed"><Fragment set:html={BEEHIIV_EMBED} /></div>
    </div>
  </section>
) : (
  <section id={id} class="signup-block relative scroll-mt-6 overflow-hidden rounded-md border border-[var(--color-rule)] bg-[var(--color-surface)] px-5 py-8 sm:px-10 sm:py-10" aria-label="Newsletter signup">
    <div class="split-rule absolute inset-x-0 top-0" aria-hidden="true"></div>
    <p class="kicker">Free newsletter</p>
    <h2 class="mt-2 font-serif text-[1.75rem] leading-tight font-semibold tracking-tight sm:text-[2.1rem]">{heading}</h2>
    <p class="mt-3 max-w-[34rem] text-[var(--color-muted)]">{blurb}</p>
    <div class="beehiiv-embed mt-6"><Fragment set:html={BEEHIIV_EMBED} /></div>
    <p class="mt-4 text-sm text-[var(--color-muted)]">Free. Unsubscribe in one click. {' '}<a href="/disclaimer/" class="inline-block py-2 -my-2 underline underline-offset-2">Not investment advice.</a></p>
  </section>
)}
<script is:inline>
  // Beehiiv injects an untitled iframe: give it an accessible name, and mark the
  // container loaded (hides the "Loading…" placeholder) once the iframe has loaded.
  (() => {
    if (window.__bhEmbed) return;
    window.__bhEmbed = true;
    const done = (box) => box && box.setAttribute('data-loaded', '');
    const scan = () => document.querySelectorAll('.beehiiv-embed iframe:not([data-bh-seen])').forEach((f) => {
      f.setAttribute('data-bh-seen', '');
      if (!f.title) f.setAttribute('title', 'Newsletter signup form');
      const box = f.closest('.beehiiv-embed');
      f.addEventListener('load', () => done(box), { once: true });
      setTimeout(() => done(box), 8000); // never leave the placeholder up forever
    });
    new MutationObserver(scan).observe(document.documentElement, { childList: true, subtree: true });
    scan();
  })();
</script>

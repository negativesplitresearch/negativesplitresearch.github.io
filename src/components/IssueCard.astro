---
import type { Issue } from '../lib/issues';
import { formatDate, readingTime } from '../lib/issues';
interface Props {
  issue: Issue;
}
const { issue } = Astro.props;
const { title, date, company, ticker, sector, summary, draft } = issue.data;
---
<article class="group border-t border-[var(--color-rule)] py-8">
  <p class="kicker">
    {sector} · {company}{ticker && ` (${ticker})`}
    {draft && <span class="ml-2 rounded-sm bg-[var(--color-ink)] px-1.5 py-0.5 text-[10px] text-[var(--color-paper)]">DRAFT</span>}
  </p>
  <h3 class="mt-2 font-serif text-2xl leading-snug font-semibold tracking-tight sm:text-[1.7rem]">
    <a href={`/issues/${issue.id}/`} class="decoration-[var(--color-accent)] decoration-2 underline-offset-4 group-hover:underline">{title}</a>
  </h3>
  <p class="mt-2 max-w-prose text-[var(--color-muted)]">{summary}</p>
  <p class="mt-3 text-[0.95rem] text-[var(--color-muted)]">
    <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingTime(issue.body)} min read
  </p>
</article>

---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="mx-auto max-w-[44rem] px-5 pt-20 sm:px-8">
    <p class="kicker">DNF</p>
    <h1 class="mt-3 font-serif text-4xl font-semibold tracking-tight">This page didn't make the finish line.</h1>
    <p class="mt-4 text-[var(--color-muted)]">Try the <a href="/issues/" class="text-[var(--color-accent)] underline">archive</a> or head <a href="/" class="text-[var(--color-accent)] underline">home</a>.</p>
  </section>
</Base>

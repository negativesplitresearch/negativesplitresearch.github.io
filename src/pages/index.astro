---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
import IssueCard from '../components/IssueCard.astro';
import RaceLine from '../components/RaceLine.astro';
import SplitSheet from '../components/SplitSheet.astro';
import { SITE, UPCOMING } from '../config';
import { getIssues, formatDate, readingTime } from '../lib/issues';

const issues = await getIssues();
const [latest, ...rest] = issues;
const recent = rest.slice(0, 3);

const benefits = [
  {
    title: 'One company, taken apart',
    body: 'Each issue picks one business or deal and works through where the money comes from, what it costs to deliver and who it competes with.',
  },
  {
    title: 'Numbers you can check',
    body: 'Figures come from annual reports, results and investor presentations, and every one is sourced and dated.',
  },
  {
    title: 'Bull and bear, side by side',
    body: 'Both cases get equal space. You get the analysis and the handful of metrics to watch. The decision stays yours.',
  },
];
---
<Base>
  <!-- Hero -->
  <section class="wrap grid items-center gap-10 pt-12 pb-8 sm:pt-20 lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] lg:gap-16 lg:pb-12">
    <div>
      <p class="kicker">Independent research · Endurance sports</p>
      <h1 class="mt-4 font-serif text-[2.6rem] leading-[1.04] font-semibold tracking-tight text-balance sm:text-6xl lg:text-[4.1rem]">
        {SITE.tagline}
      </h1>
      <p class="mt-6 max-w-[36rem] text-[1.15rem] leading-relaxed text-[var(--color-muted)] sm:text-xl">
        A free newsletter on the companies, deals and economics behind running, triathlon, cycling and swimming. For athletes who follow markets and investors who train.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
        <a href="#subscribe" class="btn w-full sm:w-auto">Get the free newsletter</a>
        <p class="text-[0.95rem] text-[var(--color-muted)]">Free. Unsubscribe in one click.</p>
      </div>
    </div>
    <div class="hidden lg:block"><SplitSheet /></div>
  </section>

  <RaceLine />

  <!-- Slim signup band -->
  <div class="mt-8 sm:mt-10">
    <Signup variant="band" id="subscribe" heading="Get the next issue in your inbox" blurb="One company, one deal, one set of numbers that matter." />
  </div>

  <!-- What you'll get -->
  <section class="wrap mt-20 sm:mt-24" aria-labelledby="get">
    <h2 id="get" class="kicker">What you'll get</h2>
    <ol class="mt-6 grid gap-x-10 gap-y-8 md:grid-cols-3">
      {benefits.map((b, i) => (
        <li class="border-t border-[var(--color-rule)] pt-5">
          <span class="tabular text-sm font-semibold text-[var(--color-accent)]">0{i + 1}</span>
          <h3 class="mt-2 font-serif text-[1.4rem] leading-snug font-semibold tracking-tight">{b.title}</h3>
          <p class="mt-2 text-[var(--color-muted)]">{b.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Latest issue -->
  {latest && (
    <section class="wrap mt-20 sm:mt-24" aria-labelledby="latest">
      <h2 id="latest" class="kicker">Latest issue</h2>
      <article class="group relative mt-6 overflow-hidden rounded-md border border-[var(--color-rule)] bg-[var(--color-surface)] transition hover:border-[var(--color-muted)]">
        <div class="split-rule" aria-hidden="true"></div>
        <div class="grid gap-8 p-6 sm:p-10 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:gap-14">
          <div>
            <p class="text-sm font-semibold tracking-wide text-[var(--color-muted)] uppercase">{latest.data.sector}</p>
            <h3 class="mt-3 font-serif text-[1.9rem] leading-[1.12] font-semibold tracking-tight text-balance sm:text-[2.6rem]">
              <a href={`/issues/${latest.id}/`} class="after:absolute after:inset-0 group-hover:underline decoration-[var(--color-accent)] decoration-2 underline-offset-[6px]">{latest.data.title}</a>
            </h3>
            <p class="mt-4 text-[1.1rem] leading-relaxed text-[var(--color-muted)]">{latest.data.summary}</p>
            <p class="mt-6 inline-flex items-center gap-2 font-semibold text-[var(--color-accent)]">Read the issue <span aria-hidden="true" class="transition group-hover:translate-x-1">→</span></p>
          </div>
          <dl class="tabular grid grid-cols-2 content-start gap-x-6 gap-y-5 border-t border-[var(--color-rule)] pt-6 text-[0.95rem] lg:grid-cols-1 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10">
            <div><dt class="text-xs font-semibold tracking-[0.14em] text-[var(--color-muted)] uppercase">Company</dt><dd class="mt-1 font-medium">{latest.data.company}{latest.data.ticker && ` (${latest.data.ticker})`}</dd></div>
            <div><dt class="text-xs font-semibold tracking-[0.14em] text-[var(--color-muted)] uppercase">Published</dt><dd class="mt-1 font-medium"><time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time></dd></div>
            <div><dt class="text-xs font-semibold tracking-[0.14em] text-[var(--color-muted)] uppercase">Reading time</dt><dd class="mt-1 font-medium">{readingTime(latest.body)} min</dd></div>
          </dl>
        </div>
      </article>
    </section>
  )}

  <!-- Upcoming topics -->
  {UPCOMING.length > 0 && (
    <section class="wrap mt-20 sm:mt-24" aria-labelledby="upcoming">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="upcoming" class="kicker">On the start line</h2>
        <p class="text-sm text-[var(--color-muted)]">Topics in research. Order may change.</p>
      </div>
      <ol class="mt-6 border-b border-[var(--color-rule)]">
        {UPCOMING.map((t, i) => (
          <li class="grid grid-cols-[2.25rem_minmax(0,1fr)] gap-x-3 border-t border-[var(--color-rule)] py-5 sm:grid-cols-[3rem_14rem_minmax(0,1fr)] sm:items-baseline sm:gap-x-6">
            <span class="tabular row-span-2 text-sm font-semibold text-[var(--color-muted)] sm:row-span-1">{String(issues.length + 1 + i).padStart(2, '0')}</span>
            <p class="font-serif text-xl font-semibold tracking-tight">
              {t.company}
              <span class="ml-2 align-middle font-sans text-xs font-semibold tracking-[0.12em] text-[var(--color-muted)] uppercase sm:mt-1 sm:ml-0 sm:block">{t.sector}</span>
            </p>
            <p class="mt-1 text-[var(--color-muted)] sm:mt-0">{t.question}</p>
          </li>
        ))}
      </ol>
      <p class="mt-6"><a href="#subscribe" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-accent)]">Get these when they land →</a></p>
    </section>
  )}

  {recent.length > 0 && (
    <section class="wrap mt-20" aria-labelledby="recent">
      <div class="flex items-baseline justify-between">
        <h2 id="recent" class="kicker">Recent issues</h2>
        <a href="/issues/" class="inline-flex min-h-11 items-center text-[0.95rem] font-semibold text-[var(--color-accent)]">All issues →</a>
      </div>
      <div class="mt-2">{recent.map((issue) => <IssueCard issue={issue} />)}</div>
    </section>
  )}
</Base>

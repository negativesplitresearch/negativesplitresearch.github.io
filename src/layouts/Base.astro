---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import { SITE, NAV } from '../config';
import ThemeToggle from '../components/ThemeToggle.astro';
import serifFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import sansFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}
const { title, description = SITE.description, image = SITE.ogImage, type = 'website', publishedTime, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:bg-[var(--color-paper)] focus:px-3 focus:py-2">Skip to content</a>
    <header class="border-b border-[var(--color-rule)]">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
        <a href="/" class="flex items-center gap-2.5 font-serif text-lg font-semibold tracking-tight sm:text-xl">
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
          {SITE.name}
        </a>
        <nav class="flex items-center gap-1 text-sm sm:gap-3" aria-label="Main">
          {NAV.map((item) => (
            <a href={item.href} class:list={['rounded px-2 py-1 transition hover:text-[var(--color-accent)]', path.startsWith(item.href) ? 'text-[var(--color-accent)]' : 'text-[var(--color-muted)]']}>{item.label}</a>
          ))}
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 border-t border-[var(--color-rule)] text-sm text-[var(--color-muted)]">
      <div class="mx-auto flex max-w-5xl flex-col gap-4 px-5 py-10 sm:flex-row sm:items-start sm:justify-between sm:px-8">
        <div>
          <p class="font-serif text-base font-semibold text-[var(--color-ink)]">{SITE.name}</p>
          <p class="mt-1">{SITE.tagline}</p>
          <p class="mt-4 font-medium text-[var(--color-ink)]">{SITE.disclaimerShort}</p>
        </div>
        <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer">
          <a href="/issues/" class="hover:text-[var(--color-accent)]">Issues</a>
          <a href="/about/" class="hover:text-[var(--color-accent)]">About</a>
          <a href="/disclaimer/" class="hover:text-[var(--color-accent)]">Disclaimer</a>
          <a href="/rss.xml" class="hover:text-[var(--color-accent)]">RSS</a>
        </nav>
      </div>
      <p class="mx-auto max-w-5xl px-5 pb-10 text-xs sm:px-8">© {new Date().getFullYear()} {SITE.name}</p>
    </footer>
  </body>
</html>

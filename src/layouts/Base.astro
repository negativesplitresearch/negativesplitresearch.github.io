---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import { SITE, NAV } from '../config';
import ThemeToggle from '../components/ThemeToggle.astro';
import Wordmark from '../components/Wordmark.astro';
import serifFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import sansFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}
const { title, description = SITE.description, image = SITE.ogImage, type = 'website', publishedTime, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:bg-[var(--color-paper)] focus:px-3 focus:py-2">Skip to content</a>
    <header class="border-b border-[var(--color-rule)]">
      <div class="wrap flex items-center justify-between gap-3 py-3.5 sm:py-4">
        <a href="/" class="-my-1 py-1"><Wordmark /></a>
        <nav class="flex items-center text-[0.95rem] sm:gap-2" aria-label="Main">
          {NAV.map((item) => (
            <a href={item.href} class:list={['inline-flex min-h-11 items-center rounded px-2.5 transition hover:text-[var(--color-accent)]', path.startsWith(item.href) ? 'text-[var(--color-accent)]' : 'text-[var(--color-muted)]']}>{item.label}</a>
          ))}
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 border-t border-[var(--color-rule)] text-[0.95rem] text-[var(--color-muted)]">
      <div class="wrap flex flex-col gap-6 py-10 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <span class="text-[var(--color-ink)]"><Wordmark size="sm" /></span>
          <p class="mt-3">{SITE.tagline}</p>
          <p class="mt-4 font-medium text-[var(--color-ink)]">{SITE.disclaimerShort}</p>
        </div>
        <nav class="flex flex-wrap gap-x-1 gap-y-1 sm:-mr-2.5" aria-label="Footer">
          {[['/issues/', 'Issues'], ['/about/', 'About'], ['/disclaimer/', 'Disclaimer'], ['/rss.xml', 'RSS']].map(([href, label]) => (
            <a href={href} class="inline-flex min-h-11 items-center px-2.5 first:pl-0 hover:text-[var(--color-accent)] sm:first:pl-2.5">{label}</a>
          ))}
        </nav>
      </div>
      <p class="wrap pb-10 text-sm">© {new Date().getFullYear()} {SITE.name}</p>
    </footer>
  </body>
</html>
